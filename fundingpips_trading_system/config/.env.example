# FundingPips Trading System Configuration

# =============================================================================
# TRADING MODE (NEVER CHANGE TO LIVE WITHOUT EXPLICIT CONFIRMATION)
# =============================================================================
TRADING_MODE=paper  # Options: backtest, paper, live

# =============================================================================
# FUNDING PIPS ACCOUNT SETTINGS
# =============================================================================
# Account size in USD (e.g., 5000, 10000, 25000, 50000, 100000)
ACCOUNT_SIZE=10000

# Phase settings
EVALUATION_PHASE=phase1  # Options: phase1, phase2, funded

# Profit target percentage (8% for phase1, 5% for phase2)
PROFIT_TARGET_PERCENT=8.0

# Maximum daily loss percentage (FundingPips rule: 5%)
MAX_DAILY_LOSS_PERCENT=5.0

# Maximum total loss percentage (FundingPips rule: 10%)
MAX_TOTAL_LOSS_PERCENT=10.0

# Minimum trading days required
MIN_TRADING_DAYS=5

# Safety buffer (operate below limits to avoid accidental breach)
DAILY_LOSS_BUFFER_PERCENT=1.0  # Stop at 4% instead of 5%
TOTAL_LOSS_BUFFER_PERCENT=1.0  # Stop at 9% instead of 10%

# =============================================================================
# RISK MANAGEMENT SETTINGS
# =============================================================================
# Risk per trade as percentage of account
RISK_PER_TRADE_PERCENT=0.5

# Maximum leverage to use (FundingPips allows up to 1:100, we use less)
MAX_LEVERAGE=10

# Maximum positions open simultaneously
MAX_OPEN_POSITIONS=3

# Maximum correlation exposure (avoid all pairs moving together)
MAX_CORRELATION_EXPOSURE=2.0

# Enable news filter (avoid trading during high-impact events)
ENABLE_NEWS_FILTER=true

# Reduce positions before weekend (optional safety measure)
WEEKEND_POSITION_REDUCTION=true

# =============================================================================
# INSTRUMENT SETTINGS
# =============================================================================
# Primary instruments to trade
INSTRUMENTS=EUR/USD,GBP/USD,XAU/USD

# Default spreads (in pips, for backtesting)
SPREAD_EURUSD=0.8
SPREAD_GBPUSD=1.2
SPREAD_XAUUSD=20.0  # Gold spread in cents

# Commission per lot (if applicable)
COMMISSION_PER_LOT=0.0

# Slippage model (pips)
SLIPPAGE_PIPS=0.5

# =============================================================================
# STRATEGY SETTINGS
# =============================================================================
# Strategy type
STRATEGY_TYPE=trend_following

# Trend following parameters
TREND_FAST_PERIOD=20
TREND_SLOW_PERIOD=50
TREND_EXIT_PERIOD=10

# Volatility overlay (ATR-based position sizing)
ATR_PERIOD=14
VOLATILITY_TARGET_PERCENT=1.0

# Timeframe for signals
TIMEFRAME=D1  # Options: H1, H4, D1

# Entry timeframe (for finer entry timing)
ENTRY_TIMEFRAME=H4

# =============================================================================
# DATA SETTINGS
# =============================================================================
# Data source
DATA_SOURCE=dukascopy  # Options: dukascopy, oanda, ibkr

# Data directory
DATA_DIR=data

# Cache directory
CACHE_DIR=.cache

# =============================================================================
# BACKTESTING SETTINGS
# =============================================================================
# Initial capital for backtesting
BACKTEST_INITIAL_CAPITAL=10000

# Commission rate (percentage)
BACKTEST_COMMISSION_RATE=0.0

# Slippage percentage
BACKTEST_SLIPPAGE_PERCENT=0.05

# =============================================================================
# LOGGING SETTINGS
# =============================================================================
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR
LOG_FILE=logs/trading_system.log

# =============================================================================
# API SETTINGS (DO NOT COMMIT REAL VALUES)
# =============================================================================
# Broker API credentials (set in .env, not here)
# BROKER_API_KEY=your_api_key_here
# BROKER_API_SECRET=your_api_secret_here
# BROKER_USERNAME=your_username
# BROKER_PASSWORD=your_password

# Economic calendar API (for news filter)
# NEWS_API_KEY=your_news_api_key

# =============================================================================
# SECURITY WARNINGS
# =============================================================================
# NEVER commit real API keys to version control
# ALWAYS use environment variables for sensitive data
# This file (.env.example) is safe to commit
# Your actual .env file should be in .gitignore
